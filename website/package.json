{
  "name": "lazymatrix-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "node scripts/prepare-benchmarks.mjs && vitepress dev . --host 127.0.0.1",
    "build": "node scripts/prepare-benchmarks.mjs && vitepress build . && node scripts/prepare-markdown.mjs && node scripts/check-site.mjs",
    "preview": "vitepress preview . --host 127.0.0.1",
    "preview:worker": "wrangler dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "markdown-it-mathjax3": "4.3.2",
    "prettier": "^3.6.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vitepress": "1.6.4",
    "wrangler": "4.149.0"
  }
}
