{
  "name": "lazymatrix-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "node scripts/prepare-reference.mjs && node scripts/prepare-benchmarks.mjs && vitepress dev . --host 127.0.0.1",
    "build": "node scripts/prepare-reference.mjs && node scripts/prepare-benchmarks.mjs && vitepress build . && node scripts/prepare-markdown.mjs && node scripts/check-site.mjs",
    "reference": "node scripts/prepare-reference.mjs",
    "preview": "vitepress preview . --host 127.0.0.1",
    "preview:worker": "wrangler dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@mdit/plugin-katex": "1.1.4",
    "@observablehq/plot": "0.6.17",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "jsdom": "30.1.3",
    "katex": "0.19.1",
    "prettier": "^3.9.10",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vitepress": "1.6.4",
    "wrangler": "4.152.0",
    "yaml": "2.9.1"
  }
}
