+
+#[inline]
+fn dense_reduce8<F: Scalar>(values: &[F], mut term: impl FnMut(F) -> F) -> F {
+    let mut sums = [F::zero(); 8];
+    let mut chunks = values.chunks_exact(8);
+    for chunk in chunks.by_ref() {
+        for lane in 0..8 {
+            sums[lane] = sums[lane] + term(chunk[lane]);
+        }
+    }
+    let mut sum = (sums[0] + sums[4]) + (sums[1] + sums[5]);
+    sum = sum + (sums[2] + sums[6]);
+    sum = sum + (sums[3] + sums[7]);
+    for &value in chunks.remainder() {
+        sum = sum + term(value);
+    }
+    sum
+}
+
+#[inline]
+fn dense_dot8<F: Scalar>(column: &[F], vector: &[F]) -> F {
+    assert_eq!(column.len(), vector.len());
+    let mut sums = [F::zero(); 8];
+    let mut left = column.chunks_exact(8);
+    let mut right = vector.chunks_exact(8);
+    for (x, y) in left.by_ref().zip(right.by_ref()) {
+        for lane in 0..8 {
+            sums[lane] = sums[lane] + x[lane] * y[lane];
+        }
+    }
+    let mut sum = (sums[0] + sums[4]) + (sums[1] + sums[5]);
+    sum = sum + (sums[2] + sums[6]);
+    sum = sum + (sums[3] + sums[7]);
+    for (&x, &y) in left.remainder().iter().zip(right.remainder()) {
+        sum = sum + x * y;
+    }
+    sum
+}
