+#[inline]
+pub(crate) fn affine_add_slices<F: Scalar>(
+    source: &[F],
+    destination: &mut [F],
+    raw_multiplier: F,
+    offset: F,
+) {
+    assert_eq!(source.len(), destination.len());
+    for (&raw, value) in source.iter().zip(destination) {
+        *value = *value + raw_multiplier * raw + offset;
+    }
+}
